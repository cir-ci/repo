{
  "pkg": "@circi/ui",
  "globalName": "CirciUI",
  "shape": "package",
  "projectId": "7603ffeb-6b04-45fc-a5d2-22e499495c10",
  "buildCmd": "pnpm --filter @circi/ui build",
  "provider": {
    "component": "CirciTheme"
  },
  "extraFonts": [
    "../../apps/web/node_modules/@fontsource-variable/inter/index.css",
    "../../apps/web/node_modules/@fontsource-variable/jetbrains-mono/index.css"
  ],
  "overrides": {
    "AppFrame": {
      "cardMode": "single",
      "viewport": "1100x420"
    },
    "PanelHeader": {
      "cardMode": "column",
      "viewport": "800x110"
    },
    "ListRow": {
      "cardMode": "column",
      "viewport": "720x270"
    },
    "StatusIcon": {
      "cardMode": "column",
      "viewport": "720x130"
    },
    "Kbd": {
      "cardMode": "column",
      "viewport": "520x200"
    },
    "NavItem": {
      "cardMode": "column",
      "viewport": "360x340"
    },
    "SegmentedControl": {
      "cardMode": "column",
      "viewport": "560x110"
    },
    "StatusChip": {
      "cardMode": "column",
      "viewport": "720x110"
    },
    "CirciTheme": {
      "cardMode": "column",
      "viewport": "760x200"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
