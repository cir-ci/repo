{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "vitest", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["**/dist/**", "packages/db/migrations/**"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": "error",
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-console": "off",
    "import/no-cycle": "error",
    // Targets Express. CirCI uses Fastify, which handles async handlers and their rejections.
    "oxc/no-async-endpoint-handlers": "off",
    // The web app uses React's automatic JSX runtime, so React needn't be in scope.
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["**/test/**/*.ts"],
      "env": {
        "vitest": true
      }
    }
  ]
}
