{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "e2e/src/**/*.ts",
    "e2e/test/**/*.ts",
    "dev/src/**/*.ts",
    "dev/test/**/*.ts",
    "perf/src/**/*.ts",
    "perf/bench/**/*.ts",
    "apps/server/tsdown.config.ts",
    "packages/cli/tsdown.config.ts",
    "packages/storybook/tsdown.config.ts",
    "packages/vitest/tsdown.config.ts",
    "packages/cypress/tsdown.config.ts",
    "scripts/retry-reporter.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "apps/web",
    "packages/ui",
    "packages/vitest/test/fixtures",
    "packages/cypress/src/support.ts",
    "packages/cypress/src/page.ts",
    "packages/cypress/test/types",
    "packages/cypress/test/fixtures",
    "packages/storybook/test/fixtures"
  ]
}
