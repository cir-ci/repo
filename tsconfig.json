{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "e2e/src/**/*.ts",
    "e2e/test/**/*.ts",
    "apps/server/tsdown.config.ts",
    "packages/cli/tsdown.config.ts",
    "packages/vitest/tsdown.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["apps/web", "packages/ui"]
}
