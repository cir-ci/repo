{
  "name": "circi-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @circi/ui --filter @circi/cli --filter @circi/vitest --filter @circi/server build && pnpm --filter @circi/web build",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web && tsc -p packages/ui && tsc -p packages/ui/tsconfig.previews.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "test": "vitest run",
    "test:e2e": "E2E=1 vitest run --project e2e",
    "test:visual": "VISUAL=1 vitest run --project ui-visual",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @circi/db generate",
    "circi": "node --conditions=@circi/source apps/server/src/main.ts",
    "clean": "rm -rf apps/*/dist packages/*/dist",
    "format:check": "oxfmt --check",
    "db:auth-schema": "pnpm --filter @circi/auth schema"
  },
  "devDependencies": {
    "@circi/ui": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1"
}
