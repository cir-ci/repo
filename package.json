{
  "name": "circi-monorepo",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "node --conditions=@circi/source dev/src/main.ts up",
    "dev:reset": "node --conditions=@circi/source dev/src/main.ts reset",
    "circi": "node --conditions=@circi/source apps/server/src/main.ts",
    "build": "turbo run build",
    "clean": "rm -rf apps/*/dist packages/*/dist .vitest coverage",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web && tsc -p packages/ui && tsc -p packages/ui/tsconfig.previews.json && tsc -p packages/cypress/tsconfig.browser.json",
    "gate": "turbo run //#format:check //#lint //#typecheck //#test:node //#test:deploy //#test:storybook //#test:cypress //#test:ui //#test:web-browser build",
    "gate:checks": "turbo run //#format:check //#lint //#typecheck",
    "gate:tests": "turbo run //#test:node //#test:deploy //#test:storybook //#test:cypress //#test:ui //#test:web-browser build",
    "gate:full": "E2E_ENV_FINGERPRINT=$(node e2e/src/stack/env-fingerprint.ts) turbo run //#format:check //#lint //#typecheck //#test:node //#test:deploy //#test:storybook //#test:cypress //#test:ui //#test:web-browser build //#e2e:api //#e2e:browser",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:deploy": "vitest run --project deploy",
    "test:storybook": "vitest run --project storybook",
    "test:cypress": "vitest run --project cypress",
    "test:ui": "vitest run --project ui --maxWorkers=25%",
    "test:web-browser": "vitest run --project web-browser --maxWorkers=25%",
    "test:coverage": "vitest run --project node --coverage",
    "test:visual": "VISUAL=1 vitest run --project ui-visual",
    "test:e2e": "E2E=1 vitest run --project e2e-api --project e2e-browser",
    "test:e2e:api": "E2E=1 vitest run --project e2e-api",
    "test:e2e:browser": "E2E=1 vitest run --project e2e-browser",
    "e2e:api": "E2E_WORKERS=${E2E_WORKERS:-2} pnpm test:e2e:api",
    "e2e:browser": "E2E_WORKERS=${E2E_WORKERS:-2} pnpm test:e2e:browser",
    "e2e:fingerprint": "node e2e/src/stack/env-fingerprint.ts",
    "test:compose": "turbo run build --filter=@circi/vitest && COMPOSE_SMOKE=1 vitest run --project compose",
    "test:helm": "deploy/helm/test.sh",
    "test:terraform": "terraform -chdir=deploy/terraform init -backend=false -input=false >/dev/null && terraform -chdir=deploy/terraform test",
    "db:generate": "pnpm --filter @circi/db generate",
    "db:auth-schema": "pnpm --filter @circi/auth schema",
    "icons:generate": "pnpm --filter @circi/ui exec node scripts/generate-lucide-icon-names.mjs",
    "perf": "node perf/src/run.ts",
    "perf:fixtures": "node perf/src/fixtures.ts",
    "perf:stack": "node perf/src/stack.ts up",
    "perf:down": "node perf/src/stack.ts down",
    "perf:bench": "node perf/bench/diff.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-chart-version.mjs && pnpm install --lockfile-only && pnpm format",
    "release": "turbo run build --filter=@circi/cli --filter=@circi/vitest --filter=@circi/cypress && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@circi/testing": "catalog:",
    "@circi/ui": "catalog:",
    "@circi/vitest": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.22.0"
}
