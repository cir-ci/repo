{
  "name": "zopheros-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @zopheros/db generate",
    "zopheros": "node --conditions=development apps/server/src/main.ts",
    "clean": "rm -rf apps/*/dist packages/*/dist apps/*/*.tsbuildinfo packages/*/*.tsbuildinfo",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.0.0"
}
