{
  "name": "circi-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web && tsc -p packages/ui && tsc -p packages/ui/tsconfig.previews.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:ui": "vitest run --project ui",
    "test:web-browser": "vitest run --project web-browser",
    "test:coverage": "vitest run --project node --coverage",
    "test:e2e": "E2E=1 vitest run --project e2e-api --project e2e-browser",
    "test:e2e:api": "E2E=1 vitest run --project e2e-api",
    "test:e2e:browser": "E2E=1 vitest run --project e2e-browser",
    "test:visual": "VISUAL=1 vitest run --project ui-visual",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @circi/db generate",
    "circi": "node --conditions=@circi/source apps/server/src/main.ts",
    "clean": "rm -rf apps/*/dist packages/*/dist .vitest coverage",
    "format:check": "oxfmt --check",
    "db:auth-schema": "pnpm --filter @circi/auth schema",
    "gate": "turbo run //#format:check //#lint //#typecheck //#test:node //#test:ui //#test:web-browser build",
    "gate:full": "turbo run //#format:check //#lint //#typecheck //#test:node //#test:ui //#test:web-browser build //#e2e:api //#e2e:browser",
    "e2e:api": "E2E_WORKERS=${E2E_WORKERS:-2} pnpm test:e2e:api",
    "e2e:browser": "E2E_WORKERS=${E2E_WORKERS:-2} pnpm test:e2e:browser"
  },
  "devDependencies": {
    "@circi/testing": "workspace:*",
    "@circi/ui": "workspace:*",
    "@circi/vitest": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1"
}
