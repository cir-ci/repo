{
  "name": "circi-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && pnpm --filter @circi/web build",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @circi/db generate",
    "circi": "node --conditions=development apps/server/src/main.ts",
    "clean": "rm -rf apps/*/dist packages/*/dist apps/*/*.tsbuildinfo packages/*/*.tsbuildinfo",
    "format:check": "oxfmt --check",
    "db:auth-schema": "pnpm --filter @circi/auth schema"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1"
}
