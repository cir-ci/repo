{
  "name": "@circi/db",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#queries/*": "./src/queries/*",
    "#queue/*": "./src/queue/*",
    "#repositories/*": "./src/repositories/*",
    "#schema/*": "./src/schema/*",
    "#shared/*": "./src/shared/*",
    "#src/*": "./src/*",
    "#testing/*": "./src/testing/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./queries": "./src/queries/index.ts",
    "./repositories": "./src/repositories/index.ts",
    "./queue": "./src/queue/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/template-db": "./src/testing/template-db.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@circi/core": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@circi/testing": "catalog:",
    "@circi/typescript-config": "catalog:",
    "@circi/vitest-config": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
