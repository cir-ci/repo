{
  "name": "@circi/integrations",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./git": "./src/git/index.ts",
    "./github": "./src/kinds/github/index.ts",
    "./gitlab": "./src/kinds/gitlab/index.ts",
    "./bitbucket": "./src/kinds/bitbucket/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@circi/api": "catalog:",
    "@circi/core": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@circi/testing": "catalog:",
    "@circi/typescript-config": "catalog:",
    "@circi/vitest-config": "catalog:"
  }
}
