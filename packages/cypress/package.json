{
  "name": "@circi/cypress",
  "version": "0.1.2",
  "description": "Cypress integration: cy.circiScreenshot() and a plugin that uploads the screenshots to CirCI",
  "keywords": [
    "cypress",
    "cypress-plugin",
    "screenshots",
    "visual-regression",
    "visual-testing"
  ],
  "homepage": "https://circi.dev/ci/cypress/",
  "bugs": {
    "url": "https://github.com/cir-ci/repo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cir-ci/repo.git",
    "directory": "packages/cypress"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "@circi/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./support": {
      "@circi/source": "./src/support.ts",
      "types": "./dist/support.d.mts",
      "default": "./dist/support.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./support": {
        "types": "./dist/support.d.mts",
        "default": "./dist/support.mjs"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.browser.json",
    "test": "vitest run"
  },
  "dependencies": {
    "tar": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@circi/cli": "catalog:",
    "@circi/testing": "catalog:",
    "@circi/tsdown-config": "catalog:",
    "@circi/typescript-config": "catalog:",
    "@circi/vitest-config": "catalog:",
    "cypress": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "cypress": ">=13"
  },
  "engines": {
    "node": ">=22"
  }
}
