{
  "name": "@circi/cli",
  "version": "0.2.0",
  "description": "Upload screenshots from CI to a CirCI server",
  "keywords": [
    "ci",
    "cli",
    "screenshots",
    "visual-regression",
    "visual-testing"
  ],
  "homepage": "https://circi.dev/ci/cli/",
  "bugs": {
    "url": "https://github.com/cir-ci/repo/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cir-ci/repo.git",
    "directory": "packages/cli"
  },
  "bin": {
    "circi": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "!dist/main.d.mts",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "@circi/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "node --conditions=@circi/source src/main.ts"
  },
  "dependencies": {
    "commander": "catalog:",
    "tar": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
