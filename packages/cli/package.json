{
  "name": "@circi/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Upload screenshots from CI to a CirCI server",
  "bin": {
    "circi": "./dist/main.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "node --conditions=development src/main.ts"
  },
  "dependencies": {
    "commander": "catalog:",
    "tar": "catalog:"
  }
}
