{
  "name": "@circi/vitest",
  "version": "0.0.0",
  "private": true,
  "description": "Vitest integration: screenshot helper, reporter that uploads to CirCI",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "@circi/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "@circi/source": "./src/browser.ts",
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./browser": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "tar": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@circi/cli": "workspace:*",
    "publint": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "vitest": ">=4"
  }
}
