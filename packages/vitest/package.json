{
  "name": "@circi/vitest",
  "version": "0.3.0",
  "description": "Vitest plugin for CirCI: uploads every toMatchScreenshot screenshot for self-hosted visual regression review",
  "keywords": [
    "browser-testing",
    "screenshot-testing",
    "screenshots",
    "self-hosted",
    "toMatchScreenshot",
    "visual-regression",
    "visual-regression-testing",
    "visual-testing",
    "vitest",
    "vitest-plugin"
  ],
  "homepage": "https://circi.dev/ci/vitest/",
  "bugs": {
    "url": "https://github.com/cir-ci/repo/issues"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cir-ci/repo.git",
    "directory": "packages/vitest"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "@circi/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "@circi/source": "./src/browser.ts",
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./browser": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "tar": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@circi/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "engines": {
    "node": ">=22"
  }
}
