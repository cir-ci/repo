{
  "name": "@circi/ui",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "@circi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "@circi/source": "./src/theme.ts",
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./tokens-css": "./tokens-css.ts",
    "./project-icons": "./src/project-icons.ts",
    "./lucide-names": "./src/lucide-names.ts",
    "./global.css": "./src/global.css",
    "./utilities.module.css": "./src/utilities.module.css",
    "./css-modules": {
      "types": "./src/css-modules.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "boring-avatars": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@circi/vitest": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
