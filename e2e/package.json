{
  "name": "@circi/e2e",
  "version": "0.0.3",
  "private": true,
  "description": "End-to-end tests against the real Docker stack (see README.md)",
  "license": "GPL-3.0-only",
  "type": "module",
  "imports": {
    "#clients/*": "./src/clients/*",
    "#fakes/*": "./src/fakes/*",
    "#github/*": "./src/github/*",
    "#reporting/*": "./src/reporting/*",
    "#src/*": "./src/*",
    "#stack/*": "./src/stack/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:compose": "COMPOSE_SMOKE=1 vitest run --project compose",
    "test:e2e": "E2E=1 vitest run --project e2e-api --project e2e-browser",
    "test:e2e:api": "E2E=1 vitest run --project e2e-api",
    "test:e2e:browser": "E2E=1 vitest run --project e2e-browser",
    "e2e:api": "E2E_WORKERS=${E2E_WORKERS:-2} pnpm test:e2e:api",
    "e2e:browser": "E2E_WORKERS=${E2E_WORKERS:-2} pnpm test:e2e:browser"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@circi/auth": "catalog:",
    "@circi/config": "catalog:",
    "@circi/core": "catalog:",
    "@circi/db": "catalog:",
    "@circi/services": "catalog:",
    "@circi/storage": "catalog:",
    "@circi/worker": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "playwright": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@circi/api": "catalog:",
    "@circi/integrations": "catalog:",
    "@circi/testing": "catalog:",
    "@circi/typescript-config": "catalog:",
    "@circi/vitest-config": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "vitest": "catalog:"
  }
}
