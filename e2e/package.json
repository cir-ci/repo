{
  "name": "@circi/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests against the real Docker stack (see README.md)",
  "type": "module",
  "imports": {
    "#clients/*": "./src/clients/*",
    "#fakes/*": "./src/fakes/*",
    "#github/*": "./src/github/*",
    "#reporting/*": "./src/reporting/*",
    "#src/*": "./src/*",
    "#stack/*": "./src/stack/*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@circi/auth": "workspace:*",
    "@circi/core": "workspace:*",
    "@circi/db": "workspace:*",
    "@circi/services": "workspace:*",
    "@circi/storage": "workspace:*",
    "@circi/worker": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "playwright": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@circi/api": "workspace:*",
    "@circi/integrations": "workspace:*",
    "@circi/testing": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "vitest": "catalog:"
  }
}
