{
  "name": "@circi/server",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "bin": {
    "circi-server": "./dist/main.mjs"
  },
  "type": "module",
  "imports": {
    "#cli/*": "./src/cli/*",
    "#http/*": "./src/http/*",
    "#composition/*": "./src/composition/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "dev": "node --conditions=@circi/source src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "pg": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@circi/api": "workspace:*",
    "@circi/auth": "workspace:*",
    "@circi/cli": "workspace:*",
    "@circi/config": "workspace:*",
    "@circi/core": "workspace:*",
    "@circi/db": "workspace:*",
    "@circi/integrations": "workspace:*",
    "@circi/services": "workspace:*",
    "@circi/sites": "workspace:*",
    "@circi/storage": "workspace:*",
    "@circi/testing": "workspace:*",
    "@circi/ui": "workspace:*",
    "@circi/worker": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/static": "catalog:",
    "commander": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "pino": "catalog:",
    "tar": "catalog:",
    "tsdown": "catalog:",
    "zod": "catalog:"
  }
}
