{
  "name": "@circi/server",
  "version": "0.2.1",
  "private": true,
  "license": "GPL-3.0-only",
  "bin": {
    "circi-server": "./dist/main.mjs"
  },
  "type": "module",
  "imports": {
    "#cli/*": "./src/cli/*",
    "#http/*": "./src/http/*",
    "#composition/*": "./src/composition/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "dev": "node --conditions=@circi/source src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "pg": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@circi/api": "catalog:",
    "@circi/auth": "catalog:",
    "@circi/cli": "catalog:",
    "@circi/config": "catalog:",
    "@circi/core": "catalog:",
    "@circi/db": "catalog:",
    "@circi/integrations": "catalog:",
    "@circi/services": "catalog:",
    "@circi/sites": "catalog:",
    "@circi/storage": "catalog:",
    "@circi/testing": "catalog:",
    "@circi/tsdown-config": "catalog:",
    "@circi/typescript-config": "catalog:",
    "@circi/ui": "catalog:",
    "@circi/vitest-config": "catalog:",
    "@circi/worker": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/static": "catalog:",
    "commander": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "pino": "catalog:",
    "tar": "catalog:",
    "tsdown": "catalog:",
    "zod": "catalog:"
  }
}
