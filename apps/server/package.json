{
  "name": "@circi/server",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "circi": "./dist/main.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "node --conditions=development src/main.ts"
  },
  "dependencies": {
    "@circi/auth": "workspace:*",
    "@circi/config": "workspace:*",
    "@circi/core": "workspace:*",
    "@circi/db": "workspace:*",
    "@circi/providers": "workspace:*",
    "@circi/storage": "workspace:*",
    "@circi/worker": "workspace:*",
    "@fastify/static": "catalog:",
    "commander": "catalog:",
    "fastify": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "drizzle-orm": "catalog:",
    "sharp": "catalog:"
  }
}
