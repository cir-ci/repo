{
  "name": "@circi/server",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "circi": "./dist/main.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "node --conditions=development src/main.ts"
  },
  "dependencies": {
    "@circi/config": "workspace:*",
    "@circi/core": "workspace:*",
    "@circi/db": "workspace:*",
    "@circi/storage": "workspace:*",
    "@circi/worker": "workspace:*",
    "@fastify/static": "10.1.8",
    "commander": "15.0.0",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "sharp": "0.35.5"
  }
}
