# Copy to deploy/.env and adjust. Never commit the real .env.

# Required: password for the bundled Postgres.
POSTGRES_PASSWORD=change-me

# Address of the dashboard: any hostname you own, e.g. https://ci.yourcompany.com
# It must be the root of its own hostname (no /sub/path). Use https outside local use.
PUBLIC_URL=http://localhost:3000

# Moving the dashboard? Put the old address(es) here, comma-separated. Requests to them
# are redirected to PUBLIC_URL, so links in old PR comments and emails keep working.
# PREVIOUS_PUBLIC_URLS=https://old-ci.yourcompany.com

# Behind a reverse proxy (nginx, Traefik, a load balancer)? List its address(es) or CIDR ranges,
# comma-separated: only they are believed when they say who the client is (X-Forwarded-For).
# Empty (the default) trusts nobody: the client is the socket's remote address, and a forged
# header can't dodge the sign-in rate limits. Without it behind a proxy, every user shares the
# proxy's address, and so one rate limit. `true` trusts any hop: unsafe unless the app is only
# reachable through the proxy. The bundled Caddy override sets it to Caddy's own address.
# TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12

# Required: signs sessions and cookies (32+ characters). Generate one with:
#   openssl rand -base64 32
# Keep it secret and stable: changing it signs everyone out.
BETTER_AUTH_SECRET=

# Outgoing mail, needed for email sign-in codes (and invitations later). Amazon SES, Postmark,
# or any SMTP server works. These settings are optional: they can be set in the dashboard
# (Instance > Settings) instead, and a variable that is set locks the setting there. Without SMTP_HOST email login is simply off.
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587                  # 465 uses implicit TLS; 587 uses STARTTLS
# SMTP_SECURE=false              # implicit TLS; default true on port 465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=CirCI <ci@yourcompany.com>
# AUTH_EMAIL_ENABLED=true        # set to false to turn email login off even with SMTP set
# AUTH_PASSWORD_ENABLED=true     # set to false for email-code-only sign-in (needs SMTP)

# Web push: leave unset and the server makes its own signing keys on first use and keeps them in
# the database. To pin them (several instances sharing keys, a restore), set the pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@yourcompany.com   # default: PUBLIC_URL

# Single sign-on (any subset). Redirect URI to register at the provider:
#   <PUBLIC_URL>/api/auth/callback/github | google | oidc
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITLAB_CLIENT_ID=
# AUTH_GITLAB_CLIENT_SECRET=
# AUTH_GITLAB_URL=https://gitlab.yourcompany.com   # a self-managed GitLab; default gitlab.com
# Any OpenID Connect provider (GitLab, Okta, Entra ID, Keycloak, Authentik...):
# AUTH_OIDC_ISSUER=https://sso.yourcompany.com
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_NAME=Company SSO
# AUTH_OIDC_TRUSTED_FOR_EMAIL=false  # true only if the provider verifies every address it reports
# AUTH_SSO_ENABLED=true          # set to false to turn single sign-on off with providers configured

# GitHub App (checks with Approve/Reject buttons, PR comments). See https://circi.dev/integrations/github/.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_API_URL=https://ghe.example.com/api/v3   # GitHub Enterprise Server only
# GITHUB_API_TIMEOUT_SECONDS=15

# Slack app (notifications in channels). Set here, it locks the Slack settings in the dashboard.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_API_URL=https://slack.com/api

# Hosting Storybook and reports: a SEPARATE domain dedicated to this (never one you use for
# anything else). Read https://circi.dev/self-hosting/site-domains/, including the cookie warning, before setting it.
# STATIC_SITES_HOST=acme-sites.com
# STATIC_SITES_MAX_MB=200
# With the bundled Caddy (docker-compose.caddy.yml):
# DASHBOARD_HOST=ci.acme.io
# SITES_HOST=acme-sites.com
# Its network (the default's 192.168.250.0/24 must not overlap one the host reaches, e.g. a VPC):
# CIRCI_SUBNET=192.168.250.0/24
# CADDY_ADDRESS=192.168.250.10

# Builds still uploading after this long fail, naming the shards that never arrived (0 = never).
# UPLOAD_TIMEOUT_MINUTES=60

# Housekeeping: unused files are deleted after GC_GRACE_HOURS, finished jobs after JOB_RETENTION_DAYS.
# GC_GRACE_HOURS=24
# JOB_RETENTION_DAYS=14
# A failed job is retried after JOB_RETRY_BASE_SECONDS, doubling each time up to JOB_RETRY_MAX_SECONDS.
# JOB_RETRY_BASE_SECONDS=2
# JOB_RETRY_MAX_SECONDS=300

# Webhooks may only point at public addresses (a receiver on localhost, a private network or a
# cloud metadata address would let anyone who can add a webhook make this server call it).
# Set true only if your receivers really live on your own network.
# WEBHOOK_ALLOW_PRIVATE_ADDRESSES=false
# How long a webhook receiver may take to answer a delivery.
# WEBHOOK_TIMEOUT_SECONDS=10

# Who may create workspaces in the dashboard: admin (instance admins only, the default)
# or anyone (every signed-in account).
# WORKSPACE_CREATION=admin

# Host port the app is published on.
CIRCI_PORT=3000

LOG_LEVEL=info

# Tuning. Connections the server's pool may open (it opens a few more of its own); the pixel-diff
# engine (native, js-workers or js) and the js-workers pool size (default: cores - 1); the most live
# dashboard streams one server keeps open.
# DATABASE_POOL_MAX=10
# CIRCI_DIFF_ENGINE=native
# CIRCI_DIFF_THREADS=
# LIVE_MAX_STREAMS=2000

# Screenshots in S3 (AWS, R2, B2, MinIO...) instead of the files volume. Without the keys the server
# uses the AWS credential chain (an instance role). docker-compose.s3.yml sets these for its local S3
# server, and reads only the two keys from here (default circi / circi-dev-secret).
# STORAGE_DRIVER=s3
# S3_BUCKET=acme-circi
# S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # not AWS
# S3_FORCE_PATH_STYLE=false      # default true with S3_ENDPOINT
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# S3 timeouts, in seconds: connecting, and silence on an open request (idle time, not total).
# S3_CONNECT_TIMEOUT_SECONDS=10
# S3_REQUEST_TIMEOUT_SECONDS=60

# Any setting can come from a file instead: <NAME>_FILE=/path (Docker or Kubernetes secrets), e.g.
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password. Setting both <NAME> and <NAME>_FILE is an error.
