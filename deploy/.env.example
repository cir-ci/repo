# Copy to deploy/.env and adjust. Never commit the real .env.

# Required: password for the bundled Postgres.
POSTGRES_PASSWORD=change-me

# Address of the dashboard: any hostname you own, e.g. https://ci.yourcompany.com
# It must be the root of its own hostname (no /sub/path). Use https outside local use.
PUBLIC_URL=http://localhost:3000

# Moving the dashboard? Put the old address(es) here, comma-separated. Requests to them
# are redirected to PUBLIC_URL, so links in old PR comments and emails keep working.
# PREVIOUS_PUBLIC_URLS=https://old-ci.yourcompany.com

# Behind a reverse proxy (nginx, Traefik, a load balancer)? List its address(es) or CIDR ranges,
# comma-separated: only they are believed when they say who the client is (X-Forwarded-For).
# Empty (the default) trusts nobody: the client is the socket's remote address, and a forged
# header can't dodge the sign-in rate limits. Without it behind a proxy, every user shares the
# proxy's address, and so one rate limit. `true` trusts any hop: unsafe unless the app is only
# reachable through the proxy. The bundled Caddy override sets it for the compose network.
# TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12

# Required: signs sessions and cookies (32+ characters). Generate one with:
#   openssl rand -base64 32
# Keep it secret and stable: changing it signs everyone out.
BETTER_AUTH_SECRET=

# Outgoing mail, needed for email sign-in codes (and invitations later). Amazon SES, Postmark,
# or any SMTP server works. Without SMTP_HOST email login is simply off.
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587                  # 465 uses implicit TLS; 587 uses STARTTLS
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=CirCI <ci@yourcompany.com>
# AUTH_EMAIL_ENABLED=true        # set to false to turn email login off even with SMTP set

# AUTH_PASSWORD_ENABLED=true     # set to false for email-code-only sign-in (needs SMTP)

# Single sign-on (any subset). Redirect URI to register at the provider:
#   <PUBLIC_URL>/api/auth/callback/github | google | oidc
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# Any OpenID Connect provider (GitLab, Okta, Entra ID, Keycloak, Authentik...):
# AUTH_OIDC_ISSUER=https://sso.yourcompany.com
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_NAME=Company SSO
# AUTH_OIDC_TRUSTED_FOR_EMAIL=false  # true only if the provider verifies every address it reports

# GitHub App (checks with Approve/Reject buttons, PR comments). See the README.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_API_URL=https://ghe.example.com/api/v3   # GitHub Enterprise Server only

# Hosting Storybook and reports: a SEPARATE domain dedicated to this (never one you use for
# anything else). Read docs/static-sites.md, including the cookie warning, before setting it.
# STATIC_SITES_HOST=acme-sites.com
# STATIC_SITES_MAX_MB=200
# With the bundled Caddy (docker-compose.caddy.yml):
# DASHBOARD_HOST=ci.acme.io
# SITES_HOST=acme-sites.com

# Builds still uploading after this long fail, naming the shards that never arrived (0 = never).
# UPLOAD_TIMEOUT_MINUTES=60

# Webhooks may only point at public addresses (a receiver on localhost, a private network or a
# cloud metadata address would let anyone who can add a webhook make this server call it).
# Set true only if your receivers really live on your own network.
# WEBHOOK_ALLOW_PRIVATE_ADDRESSES=false

# Who may create organizations in the dashboard: admin (instance admins only, the default)
# or anyone (every signed-in account).
# ORG_CREATION=admin

# Host port the app is published on.
CIRCI_PORT=3000

LOG_LEVEL=info

# Only used with docker-compose.s3.yml (local MinIO credentials).
# S3_ACCESS_KEY_ID=circi
# S3_SECRET_ACCESS_KEY=circi-dev-secret
