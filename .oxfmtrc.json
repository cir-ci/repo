{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "ignorePatterns": [
    ".claude/**",
    "**/*.md",
    "packages/db/migrations/**",
    "deploy/helm/circi/templates/**",
    "deploy/helm/circi/files/**",
    "pnpm-lock.yaml"
  ]
}
