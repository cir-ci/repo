{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["pnpm-lock.yaml", "pnpm-workspace.yaml"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "CI",
    "CIRCLE_BUILD_URL",
    "FLAKINESS_ACCESS_TOKEN",
    "FLAKINESS_DISABLE_UPLOAD",
    "CIRCI_TEST_DATABASE_URL",
    "DOCKER_*",
    "TESTCONTAINERS_*"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md"],
      "outputs": []
    },
    "@circi/vitest#test": {
      "dependsOn": ["transit", "build"],
      "inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md"],
      "outputs": []
    },
    "@circi/cypress#test": {
      "dependsOn": ["transit", "build"],
      "inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md"],
      "outputs": []
    },
    "@circi/ui#test:visual": {
      "dependsOn": ["@circi/vitest#build"],
      "cache": false,
      "passThroughEnv": ["CIRCI_*"]
    },
    "//#format:check": {
      "inputs": [
        "$TURBO_ROOT$/{apps,packages,e2e,dev,docs,deploy,perf}/**",
        "$TURBO_ROOT$/*.{json,ts,yaml,md}",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!$TURBO_ROOT$/e2e/.artifacts/**",
        "!$TURBO_ROOT$/perf/{fixtures,.state,results}/**"
      ],
      "outputs": []
    },
    "//#lint": {
      "inputs": [
        "$TURBO_ROOT$/{apps,packages,e2e,dev,perf}/**/*.{ts,tsx,js,json,css}",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/*.{ts,json}",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!$TURBO_ROOT$/e2e/.artifacts/**",
        "!$TURBO_ROOT$/perf/{fixtures,.state,results}/**"
      ],
      "outputs": []
    },
    "@circi/e2e#e2e:api": {
      "inputs": [
        "$TURBO_ROOT$/deploy/Dockerfile",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/e2e/vitest.config.ts",
        "$TURBO_ROOT$/packages/vitest-config/**",
        "$TURBO_ROOT$/e2e/compose.yml",
        "$TURBO_ROOT$/e2e/package.json",
        "$TURBO_ROOT$/e2e/tsconfig.json",
        "$TURBO_ROOT$/e2e/src/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/e2e/test/**/*.e2e.test.ts",
        "!$TURBO_ROOT$/e2e/test/**/*.browser.e2e.test.ts",
        "$TURBO_ROOT$/apps/{server,worker}/**",
        "$TURBO_ROOT$/packages/api/**",
        "$TURBO_ROOT$/packages/auth/**",
        "$TURBO_ROOT$/packages/config/**",
        "$TURBO_ROOT$/packages/core/**",
        "$TURBO_ROOT$/packages/db/**",
        "$TURBO_ROOT$/packages/diff/**",
        "$TURBO_ROOT$/packages/integrations/**",
        "$TURBO_ROOT$/packages/services/**",
        "$TURBO_ROOT$/packages/sites/**",
        "$TURBO_ROOT$/packages/storage/**",
        "$TURBO_ROOT$/packages/cli/**",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/.vitest/**",
        "!**/.turbo/**",
        "!$TURBO_ROOT$/{apps,packages}/**/test/**",
        "!$TURBO_ROOT$/{apps,packages}/**/*.test.{ts,tsx}"
      ],
      "outputs": [],
      "cache": true,
      "env": ["E2E_SKIP_BUILD", "E2E_ENV_FINGERPRINT"],
      "passThroughEnv": [
        "DOCKER_*",
        "E2E_WORKERS",
        "E2E_POOL_MAX",
        "XDG_RUNTIME_DIR",
        "TMPDIR",
        "PLAYWRIGHT_*",
        "CI"
      ],
      "dependsOn": ["@circi/cli#build"]
    },
    "@circi/e2e#e2e:browser": {
      "inputs": [
        "$TURBO_ROOT$/deploy/Dockerfile",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/e2e/vitest.config.ts",
        "$TURBO_ROOT$/packages/vitest-config/**",
        "$TURBO_ROOT$/e2e/compose.yml",
        "$TURBO_ROOT$/e2e/package.json",
        "$TURBO_ROOT$/e2e/tsconfig.json",
        "$TURBO_ROOT$/e2e/src/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/e2e/test/**/*.browser.e2e.test.ts",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/.vitest/**",
        "!**/.turbo/**",
        "!$TURBO_ROOT$/{apps,packages}/**/test/**",
        "!$TURBO_ROOT$/{apps,packages}/**/*.test.{ts,tsx}"
      ],
      "outputs": [],
      "cache": true,
      "env": ["E2E_SKIP_BUILD", "E2E_ENV_FINGERPRINT"],
      "passThroughEnv": [
        "DOCKER_*",
        "E2E_WORKERS",
        "E2E_POOL_MAX",
        "XDG_RUNTIME_DIR",
        "TMPDIR",
        "PLAYWRIGHT_*",
        "CI"
      ],
      "dependsOn": ["@circi/cli#build"]
    }
  }
}
