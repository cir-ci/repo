{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "tsconfig.json",
    "tsdown.shared.ts"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["dist/**"]
    },
    "//#format:check": {
      "inputs": [
        "$TURBO_ROOT$/{apps,packages,e2e,dev,docs,deploy,perf}/**",
        "$TURBO_ROOT$/*.{json,ts,yaml,md}",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!$TURBO_ROOT$/e2e/.artifacts/**",
        "!$TURBO_ROOT$/perf/{fixtures,.state,results}/**"
      ],
      "outputs": []
    },
    "//#lint": {
      "inputs": [
        "$TURBO_ROOT$/{apps,packages,e2e,dev,perf}/**/*.{ts,tsx,js,json,css}",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/*.{ts,json}",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!$TURBO_ROOT$/e2e/.artifacts/**",
        "!$TURBO_ROOT$/perf/{fixtures,.state,results}/**"
      ],
      "outputs": []
    },
    "//#typecheck": {
      "inputs": [
        "$TURBO_ROOT$/{apps,packages,e2e,dev,perf}/**/*.{ts,tsx,js,json,css,d.ts}",
        "$TURBO_ROOT$/*.{ts,json}",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!$TURBO_ROOT$/e2e/.artifacts/**",
        "!$TURBO_ROOT$/perf/{fixtures,.state,results}/**"
      ],
      "outputs": []
    },
    "//#test:node": {
      "inputs": [
        "$TURBO_ROOT$/{apps,packages}/**",
        "$TURBO_ROOT$/e2e/**",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/{dev,perf}/package.json",
        "!$TURBO_ROOT$/e2e/.artifacts/**",
        "!$TURBO_ROOT$/perf/{fixtures,.state,results}/**",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/.vitest/**",
        "!**/.turbo/**"
      ],
      "outputs": [],
      "dependsOn": ["@circi/vitest#build"]
    },
    "//#test:deploy": {
      "inputs": [
        "$TURBO_ROOT$/packages/config/**",
        "$TURBO_ROOT$/deploy/**",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/package.json",
        "!**/node_modules/**",
        "!**/.terraform/**",
        "!**/.turbo/**"
      ],
      "outputs": [],
      "dependsOn": ["@circi/vitest#build"]
    },
    "//#test:storybook": {
      "inputs": [
        "$TURBO_ROOT$/packages/{storybook,cli,testing}/**",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/package.json",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.vitest/**",
        "!**/.turbo/**",
        "!$TURBO_ROOT$/packages/storybook/test/fixtures/.run-*/**"
      ],
      "outputs": [],
      "dependsOn": ["@circi/vitest#build"]
    },
    "//#test:cypress": {
      "inputs": [
        "$TURBO_ROOT$/packages/{cypress,cli,testing}/**",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/package.json",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.vitest/**",
        "!**/.turbo/**",
        "!$TURBO_ROOT$/packages/cypress/test/fixtures/.run-*/**"
      ],
      "outputs": [],
      "dependsOn": ["@circi/vitest#build", "@circi/cypress#build"]
    },
    "//#test:vitest": {
      "inputs": [
        "$TURBO_ROOT$/packages/{vitest,cli,testing}/**",
        "$TURBO_ROOT$/package.json",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/.run-*/**",
        "!**/.vitest/**",
        "!**/.turbo/**"
      ],
      "outputs": [],
      "dependsOn": ["@circi/vitest#build"]
    },
    "//#test:ui": {
      "inputs": [
        "$TURBO_ROOT$/packages/ui/**",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/package.json",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/.vitest/**",
        "!**/.turbo/**"
      ],
      "outputs": [],
      "dependsOn": ["@circi/vitest#build"]
    },
    "//#test:web-browser": {
      "inputs": [
        "$TURBO_ROOT$/{apps/web,packages/ui,packages/api,packages/core}/**",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/package.json",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/.vitest/**",
        "!**/.turbo/**"
      ],
      "outputs": [],
      "dependsOn": ["@circi/vitest#build"]
    },
    "//#e2e:api": {
      "inputs": [
        "$TURBO_ROOT$/deploy/Dockerfile",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/e2e/compose.yml",
        "$TURBO_ROOT$/e2e/package.json",
        "$TURBO_ROOT$/e2e/tsconfig.json",
        "$TURBO_ROOT$/e2e/src/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/e2e/test/**/*.e2e.test.ts",
        "!$TURBO_ROOT$/e2e/test/**/*.browser.e2e.test.ts",
        "$TURBO_ROOT$/apps/{server,worker}/**",
        "$TURBO_ROOT$/packages/api/**",
        "$TURBO_ROOT$/packages/auth/**",
        "$TURBO_ROOT$/packages/config/**",
        "$TURBO_ROOT$/packages/core/**",
        "$TURBO_ROOT$/packages/db/**",
        "$TURBO_ROOT$/packages/diff/**",
        "$TURBO_ROOT$/packages/integrations/**",
        "$TURBO_ROOT$/packages/services/**",
        "$TURBO_ROOT$/packages/sites/**",
        "$TURBO_ROOT$/packages/storage/**",
        "$TURBO_ROOT$/packages/cli/**",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/.vitest/**",
        "!**/.turbo/**",
        "!$TURBO_ROOT$/{apps,packages}/**/test/**",
        "!$TURBO_ROOT$/{apps,packages}/**/*.test.{ts,tsx}"
      ],
      "outputs": [],
      "cache": true,
      "env": ["E2E_SKIP_BUILD", "E2E_ENV_FINGERPRINT"],
      "passThroughEnv": [
        "DOCKER_*",
        "E2E_WORKERS",
        "E2E_POOL_MAX",
        "XDG_RUNTIME_DIR",
        "TMPDIR",
        "PLAYWRIGHT_*",
        "CI"
      ],
      "dependsOn": ["@circi/vitest#build"]
    },
    "//#e2e:browser": {
      "inputs": [
        "$TURBO_ROOT$/deploy/Dockerfile",
        "$TURBO_ROOT$/.dockerignore",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/e2e/compose.yml",
        "$TURBO_ROOT$/e2e/package.json",
        "$TURBO_ROOT$/e2e/tsconfig.json",
        "$TURBO_ROOT$/e2e/src/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/e2e/test/**/*.browser.e2e.test.ts",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/.vitest/**",
        "!**/.turbo/**",
        "!$TURBO_ROOT$/{apps,packages}/**/test/**",
        "!$TURBO_ROOT$/{apps,packages}/**/*.test.{ts,tsx}"
      ],
      "outputs": [],
      "cache": true,
      "env": ["E2E_SKIP_BUILD", "E2E_ENV_FINGERPRINT"],
      "passThroughEnv": [
        "DOCKER_*",
        "E2E_WORKERS",
        "E2E_POOL_MAX",
        "XDG_RUNTIME_DIR",
        "TMPDIR",
        "PLAYWRIGHT_*",
        "CI"
      ],
      "dependsOn": ["@circi/vitest#build"]
    }
  }
}
